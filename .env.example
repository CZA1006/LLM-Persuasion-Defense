# Target model backend: openai or deepseek
PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible alternative
# PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional attacker overrides. If omitted, the attacker inherits the target backend.
# ATTACK_PROVIDER=deepseek
# ATTACK_DEEPSEEK_MODEL=deepseek-chat
# ATTACK_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
